<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ef_paper">

    <!-- Full-screen procedural Endfield Topographic Contours & Tactical Grid Backdrop -->
    <com.flashskip.ui.EndfieldBackdropView
        android:id="@+id/endfieldBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Full-screen soft Chibi-Cat Sketchbook Backdrop (Meow theme) -->
    <com.flashskip.ui.MeowBackdropView
        android:id="@+id/meowBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Legacy corner contours kept gone for backward layout compatibility -->
    <ImageView
        android:id="@+id/ivContourTopRight"
        android:layout_width="290dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ic_ef_contours"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivContourBottomLeft"
        android:layout_width="320dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:scaleType="fitXY"
        android:src="@drawable/ic_ef_contours"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/console_header" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <include layout="@layout/console_tabs_content" />
        </ScrollView>

        <!-- Dual-Theme 3-Tab Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/tabNavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ef_panel"
            android:orientation="vertical">

            <View
                android:id="@+id/navDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ef_hairline"
                android:background="@color/ef_rule" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/tabHomeIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/fs_nav_home" />

                    <TextView
                        android:id="@+id/tabHomeEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOME"
                        android:textSize="9.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabHomeZh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="首页"
                        android:textColor="@color/ef_ink"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabKeepAlive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/tabKeepAliveIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/fs_nav_shield" />

                    <TextView
                        android:id="@+id/tabKeepAliveEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GUARD"
                        android:textSize="9.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabKeepAliveZh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="后台保活"
                        android:textColor="@color/ef_ink"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabMore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/tabMoreIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/fs_nav_settings" />

                    <TextView
                        android:id="@+id/tabMoreEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIG"
                        android:textSize="9.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabMoreZh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="更多设置"
                        android:textColor="@color/ef_ink"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
