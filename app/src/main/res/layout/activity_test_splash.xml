<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvAdTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/fake_ad_text"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_skip_bg"
        android:minWidth="88dp"
        android:minHeight="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="跳过 3s"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFakeSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_skip_bg"
        android:gravity="center"
        android:minWidth="88dp"
        android:minHeight="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="跳过 3s"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnCenterSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="140dp"
        android:background="@drawable/btn_skip_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="跳过"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnBackManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="@string/btn_close_test"
        android:visibility="gone" />
</FrameLayout>
