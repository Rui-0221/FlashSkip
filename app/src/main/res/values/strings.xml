    <string name="app_name">FlashSkip</string>
    <string name="app_display_name">FlashSkip 闪跳</string>
    <string name="service_desc">帮您自动跳过打开应用时的开屏广告。仅在应用打开后的几秒内识别“跳过”按钮，默认自动避开银行、支付和系统软件，不联网、不读取个人隐私。</string>
