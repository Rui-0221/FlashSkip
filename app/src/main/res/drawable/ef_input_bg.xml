<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ef_panel_subtle" />
            <corners android:radius="@dimen/fs_inner_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/ef_signal" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ef_panel_subtle" />
            <corners android:radius="@dimen/fs_inner_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/ef_rule" />
        </shape>
    </item>
</selector>
