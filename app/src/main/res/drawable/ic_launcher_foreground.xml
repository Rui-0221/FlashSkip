<?xml version="1.0" encoding="utf-8"?>
<!--
    FlashSkip launcher foreground ("闪跳"):
    - open countdown ring = splash-ad "skip 3s" countdown being cut short;
    - lightning bolt + end bar = "skip next" glyph, i.e. skipping in a flash.
    All artwork stays strictly inside the 66dp adaptive-icon safe zone (radius <= 30dp around 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- soft inner disc -->
    <path
        android:fillColor="#1AFFFFFF"
        android:pathData="M54,33 a21,21 0 1,0 0,42 a21,21 0 1,0 0,-42 z" />
    <!-- remaining countdown track -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31.05,40.75 A26.5,26.5 0 0,1 54,27.5"
        android:strokeWidth="4"
        android:strokeColor="#40FFFFFF"
        android:strokeLineCap="round" />
    <!-- countdown progress ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,27.5 A26.5,26.5 0 1,1 31.05,40.75"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
    <!-- progress head spark -->
    <path
        android:fillColor="#FFFFD43B"
        android:pathData="M31.05,37.25 a3.5,3.5 0 1,0 0,7 a3.5,3.5 0 1,0 0,-7 z" />
    <!-- skip bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M65.25,41.4 H67.95 A2.25,2.25 0 0,1 70.2,43.65 V64.35 A2.25,2.25 0 0,1 67.95,66.6 H65.25 A2.25,2.25 0 0,1 63.0,64.35 V43.65 A2.25,2.25 0 0,1 65.25,41.4 Z" />
    <!-- lightning bolt -->
    <path android:pathData="M54.9,35.1 L37.8,56.7 H49.1 L45.5,72.9 L61.2,51.3 H50.9 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="41"
                android:startY="35"
                android:endX="58"
                android:endY="73">
                <item android:offset="0" android:color="#FFFFF27A" />
                <item android:offset="1" android:color="#FFFFB300" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
