<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFF" />
                    <size android:width="22dp" android:height="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/ef_panel" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/ef_rule" />
                    <size android:width="22dp" android:height="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
